# Public-app — copy to public-app/.env.local (never commit real secrets).

# Database (Neon/Supabase in prod). No stock/value columns ever (CLAUDE.md §2).
# Local dev uses the public-app Postgres container on port 5433 (see docker-compose.yml).
DATABASE_URL=postgresql://ama:ama@localhost:5433/public_app

# Sync channel (Phase 4) — must match gestion values.
SYNC_SERVICE_TOKEN=
SYNC_HMAC_SECRET=

# Field session signing (Phase 5).
SESSION_SECRET=
LOGIN_MAX_PIN_ATTEMPTS=5

# Branding
NEXT_PUBLIC_APP_NAME=Inventory
