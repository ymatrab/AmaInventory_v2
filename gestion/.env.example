# Gestion backend / Docker stack — copy to gestion/.env (never commit the real .env).

# Django
DJANGO_SECRET_KEY=dev-insecure-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Database (Postgres container)
POSTGRES_USER=gestion
POSTGRES_PASSWORD=gestion
POSTGRES_DB=gestion
DATABASE_URL=postgres://gestion:gestion@postgres:5432/gestion

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# SAP seam — mock by default (Phase 2). Real DSN wired later on the company network.
USE_SAP_MOCK=true
SAP_DSN=                      # SEAM: real SAP read-only connection (unused while mock)

# Sync channel to the public app (Phase 4) — must match public-app values.
PUBLIC_API_BASE_URL=http://host.docker.internal:3000
SYNC_SERVICE_TOKEN=          # must match public
SYNC_HMAC_SECRET=            # must match public
SYNC_POLL_SECONDS=120

# Frontend (Vite) dev
VITE_API_BASE_URL=http://localhost:8000
